# GROQ_API_KEY: Primary LLM API key for MAMO CLINICAL SIMULATOR AI (server-side only).
# Configure this in the AI Studio Secrets panel.
GROQ_API_KEY=your_groq_api_key_here

# AI_PROVIDER: Default server AI provider ("groq" primary or "gemini" secondary).
AI_PROVIDER="groq"

# GEMINI_API_KEY: Optional secondary Gemini AI API key (server-side only).
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server listen port (Render injects this automatically; defaults to 3000 locally).
PORT="3000"

# NODE_ENV: "development" locally or "production" on Render.
NODE_ENV="production"
